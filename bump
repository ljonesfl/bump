#!/usr/bin/ruby

require 'json'
require 'optparse'

VERSION_FILE = '.version.json'

def xcode_project_dirs
  paths = Dir.glob("**/*.xcodeproj") + Dir.glob("**/*.xcworkspace")
  paths.map { |path| File.dirname(path) }.uniq
end

def update_xcode_versions_with_agvtool(project_dirs, marketing_version, bundle_version)
  project_dirs.each do |dir|
    marketing_ok = system("agvtool", "new-marketing-version", marketing_version,
                          out: File::NULL, err: File::NULL, chdir: dir)
    warn "agvtool failed to update MARKETING_VERSION in #{dir}." unless marketing_ok

    bundle_ok = system("agvtool", "new-version", "-all", bundle_version,
                       out: File::NULL, err: File::NULL, chdir: dir)
    warn "agvtool failed to update CURRENT_PROJECT_VERSION in #{dir}." unless bundle_ok
  end
end

def flutter_project?
  File.file?("pubspec.yaml") && File.read("pubspec.yaml").match?(/^flutter:/)
end

def update_pubspec_version(marketing_version, bundle_version)
  return unless File.file?("pubspec.yaml")

  contents = File.read("pubspec.yaml")
  updated = contents.sub(/^version:\s*.*$/, "version: #{marketing_version}+#{bundle_version}")
  return if updated == contents

  File.write("pubspec.yaml", updated)
end

def pubspec_build_number
  return 0 unless File.file?("pubspec.yaml")

  match = File.read("pubspec.yaml").match(/^version:\s*[^\s+#]+(?:\+(\d+))?/)
  match && match[1] ? match[1].to_i : 0
end

# CURRENT_PROJECT_VERSION as agvtool reports it. Flutter projects resolve
# $(FLUTTER_BUILD_NUMBER) at build time, so there is nothing authoritative to
# read back from the Xcode project there.
def xcode_build_number
  return 0 if flutter_project?

  xcode_project_dirs.map do |dir|
    output = begin
      IO.popen([ "agvtool", "what-version", "-terse" ], chdir: dir, err: File::NULL, &:read)
    rescue SystemCallError
      nil
    end
    output.to_s.strip[/\A\d+\z/].to_i
  end.max || 0
end

# The highest build number already recorded anywhere in the project. A manual
# archive can advance the project past .version.json, and the counter must not
# fall back behind it.
def project_build_floor
  [ pubspec_build_number, xcode_build_number ].max
end

class Version
  attr_accessor :strategy

  def initialize
    @strategy = 'semver'
    @major    = 0
    @minor    = 0
    @patch    = 0
    @build    = 0
  end

  def load(file = VERSION_FILE )
    unless File.file?( file )
      raise file + " not found."
    end

    @file = file
    @parts = JSON.parse( File.read( file ) )

    @strategy = @parts[ 'strategy' ]
    @major    = @parts[ 'major' ].to_i
    @minor    = @parts[ 'minor' ].to_i
    @patch    = @parts[ 'patch' ].to_i
    @build    = @parts[ 'build' ].to_i
    adopt_higher_project_build
  end

  # App Store CFBundleVersion and Play versionCode must never go backwards.
  # If the project files already claim a higher build, that is the floor.
  def adopt_higher_project_build
    higher = project_build_floor
    @build = higher if higher > @build
  end

  def save( file = VERSION_FILE )
    ver = {
      "strategy"  => @strategy,
      "major"     => @major,
      "minor"     => @minor,
      "patch"     => @patch,
      "build"     => @build
    }

    @file = file
    json = JSON.pretty_generate( ver )

    File.open( @file, "w" ) do |f|
      f.write( json )
    end
  end

  def bump_major
    if @strategy != 'semver'
      raise "Cannot bump the major version using the date strategy."
    end

    @major += 1
    @minor = 0
    @patch = 0
    bump_build
  end

  def bump_minor
    if @strategy != 'semver'
      raise "Cannot bump the minor version using the date strategy."
    end
    @minor += 1
    @patch = 0
    bump_build
  end

  def bump_patch
    if @strategy != 'semver'
      raise "Cannot bump the patch version using the date strategy."
    end

    @patch += 1
    bump_build
  end

  def bump_build
    @build += 1
  end

  def stamp
    if @strategy != 'date'
      raise "Cannot stamp the version using the semver strategy."
    end

    @major = Time.now.year
    @minor = Time.now.month
    @patch = Time.now.day

    # The build is a lifetime counter, so re-stamping a date that has not
    # changed still advances it. That is what makes same-day releases
    # distinguishable without having to count how many there have been.
    bump_build
  end

  # Git tag / versionlog. The date strategy always carries the build number:
  # every release on a given day shares a marketing version, so the build is
  # the only thing that tells them apart. Semver versions never repeat, so
  # they stay three parts.
  def string
    return marketing_string + '.' + @build.to_s if @strategy == 'date'

    marketing_string
  end

  # Apple CFBundleShortVersionString: at most three integers (x.y.z).
  def marketing_string
    @major.to_s + '.' + @minor.to_s + '.' + @patch.to_s
  end

  # Apple CFBundleVersion / Play versionCode / Flutter +build. A lifetime
  # counter that only ever increases. Both stores demand a positive integer,
  # so zero -- which can now only mean "never bumped" -- floors to one.
  def bundle_version
    [@build, 1].max.to_s
  end

end

#-------------------------------------------------------------
# Main
# ------------------------------------------------------------

write = false

opts = {
  :strategy => false,
  :major    => false,
  :minor    => false,
  :patch    => false,
  :build    => false,
  :file     => VERSION_FILE,
  :stamp    => false
}

optparse = OptionParser.new do |options|
  options.on( '-h', '-?', '--help', 'Show help.' ) do
    puts options
    exit
  end

  options.on( '--strategy [STRATEGY]', String, "Set the versioning strategy semver|date (defaults to semver)" ) do |strategy|
    if strategy != 'semver' && strategy != 'date'
      puts "Invalid strategy: " + strategy
      exit 1
    end
    opts[ :strategy ] = strategy
    if strategy == 'date'
      opts[ :stamp ] = true
    end
  end

  options.on( '--stamp', "Stamp the current date." ) do
    opts[ :stamp ] = true
  end

  options.on( '-n', '--new', "Create new file." ) do
    opts[ :new ] = true
  end

  options.on( '-a', '--major', 'Bump major number.' ) do
    opts[ :major ] = true
  end

  options.on( '-m', '--minor', 'Bump minor number.' ) do
    opts[ :minor ] = true
  end

  options.on( '-p', '--patch', 'Bump patch number.' ) do
    opts[ :patch ] = true
  end

  options.on( '-b', '--build', 'Bump build number.' ) do
    opts[ :build ] = true
  end

  options.on( '-f', '--file [FILE]', String, "Specify file. (defaults to #{VERSION_FILE})" ) do |name|
    opts[ :file ] = name
  end

end

optparse.parse($*)

ver = Version.new

if opts[ :new ]
    ver.save( opts[ :file ] )
    puts "File created."
else
  begin
    ver.load( opts[ :file ] )
  rescue Exception => e
    p e.message
  end
end

begin
  if opts[ :strategy ]
    ver.strategy = opts[ :strategy ]
    write = true
  end

  if opts[ :stamp ]
    ver.stamp
    write = true
  end

  if opts[ :major ]
    ver.bump_major
    write = true
  end

  if opts[ :minor ]
    ver.bump_minor
    write = true
  end

  if opts[ :patch ]
    ver.bump_patch
    write = true
  end

  if opts[ :build ]
    ver.bump_build
    write = true
  end

  if write
    ver.save
  end
rescue Exception => ex
  puts ex.message
  exit 1
end

if write
  update_pubspec_version(ver.marketing_string, ver.bundle_version)

  # Flutter Info.plist uses $(FLUTTER_BUILD_*), so skip agvtool there.
  # Native Xcode apps still get MARKETING_VERSION + CURRENT_PROJECT_VERSION.
  unless flutter_project?
    project_dirs = xcode_project_dirs
    if project_dirs.any?
      update_xcode_versions_with_agvtool(project_dirs, ver.marketing_string, ver.bundle_version)
    end
  end
end

puts ver.string
